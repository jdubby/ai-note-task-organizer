# Server Configuration
PORT=5001
NODE_ENV=development

# MongoDB
# For local development with Docker Compose (no auth):
MONGODB_URI=mongodb://localhost:27017/note-task-organizer

# For MongoDB with authentication (production):
# MONGODB_URI=mongodb://username:password@localhost:27017/note-task-organizer?authSource=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
# IMPORTANT: Change this to a strong random secret in production!
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# AI Inference Service (Ollama)
AI_INFERENCE_URL=http://localhost:11434
AI_MODEL=phi4-mini:3.8b
# Optional: Service token for inference API authentication
# INFERENCE_SERVICE_TOKEN=

# MinIO/S3 Object Storage (optional, for production)
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=notes
# S3_REGION=us-east-1

# OpenAI (legacy - not currently used, but kept for compatibility)
# OPENAI_API_KEY=sk-...

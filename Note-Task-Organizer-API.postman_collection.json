								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/jobs/{{upload_job_id}}",
							"host": ["{{base_url}}"],
							"path": ["api", "jobs", "{{upload_job_id}}"]
						},
						"description": "Check the status of an upload processing job. States: waiting, active, completed, failed"
					},
					"response": []

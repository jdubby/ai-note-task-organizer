		{
			"name": "File Upload",
			"item": [
				{
					"name": "Upload File",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 202) {",
									"    const jsonData = pm.response.json();",
									"    if (jsonData.jobs && jsonData.jobs.length > 0) {",
									"        pm.environment.set('upload_job_id', jsonData.jobs[0].jobId);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{auth_token}}"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "files",
									"type": "file",
									"src": [],
									"description": "Upload one or more markdown/text files"
								},
								{
									"key": "category",
									"value": "work",
									"type": "text",
									"description": "Category: work or personal"
								},
								{
									"key": "isPrivate",
									"value": "false",
									"type": "text",
									"description": "Mark as private: true or false"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/upload",
							"host": ["{{base_url}}"],
							"path": ["api", "upload"]
						},
						"description": "Upload file(s) for AI processing. Returns job ID(s) for background processing."
					},
					"response": []
				},
				{
					"name": "Get Job Status",
					"request": {
						"method": "GET",
						"header": [

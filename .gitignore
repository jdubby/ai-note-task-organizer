# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/client/node_modules
/server/node_modules
/packages/*/node_modules
/.pnp
.pnp.js

# testing
/coverage
.nyc_output

# production
/build
/dist
/server/dist
/packages/*/dist
*.tsbuildinfo

# TypeScript build artifacts (should not be in source)
*.js.map
*.d.ts.map
packages/*/src/*.js
packages/*/src/*.d.ts
packages/*/src/*.map

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
/server/.env
/.env

# Uploads and user-generated content
/server/uploads/
/uploads/

# misc
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.cursor/

# Cache
.cache/
.temp/

# Temporary agent files (planning, reviews, analysis)
/tmp/agent/

# Package manager lock files (if using pnpm, ignore npm/yarn locks)
package-lock.json
yarn.lock
/client/package-lock.json
